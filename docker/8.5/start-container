#!/usr/bin/env bash

if [ "$SUPERVISOR_PHP_USER" != "root" ] && [ "$SUPERVISOR_PHP_USER" != "sail" ]; then
    echo "You should set SUPERVISOR_PHP_USER to either 'sail' or 'root'."
    exit 1
fi

if [ ! -z "$WWWUSER" ]; then
    usermod -u $WWWUSER sail
fi

if [ ! -d /.composer ]; then
    mkdir /.composer
fi

chmod -R ugo+rw /.composer

if [ $# -gt 0 ]; then
    if [ "$SUPERVISOR_PHP_USER" = "root" ]; then
        exec "$@"
    else
        exec gosu $WWWUSER "$@"
    fi
else
    # Prvotna inicializacia aplikacie (pridane do Sail runtime, viac v init-app).
    # Ak zlyha, kontajner sa ukonci a chyba je v "docker compose logs laravel.test".
    /usr/local/bin/init-app || { echo "[init] CHYBA: inicializacia zlyhala"; exit 1; }
    exec /usr/bin/supervisord -c /etc/supervisor/conf.d/supervisord.conf
fi
